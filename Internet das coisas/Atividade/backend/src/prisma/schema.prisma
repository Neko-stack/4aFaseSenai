generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String   @db.VarChar(120)
  email    String   @unique @db.VarChar(160)
  senhaHash String  @map("senha_hash") @db.VarChar(255)
  perfil   String   @default("OPERADOR") @db.VarChar(20)
  historicos HistoricoAgendamento[]

  @@map("usuario")
}

model Cliente {
  id            Int            @id @default(autoincrement())
  nome          String         @db.VarChar(150)
  telefone      String         @db.VarChar(20)
  email         String?        @db.VarChar(160)
  endereco      String         @db.VarChar(255)
  agendamentos  Agendamento[]

  @@map("cliente")
}

model Profissional {
  id            Int            @id @default(autoincrement())
  nome          String         @db.VarChar(150)
  telefone      String         @db.VarChar(20)
  email         String?        @db.VarChar(160)
  ativo         Boolean        @default(true)
  horaInicio    DateTime       @map("hora_inicio") @db.Time(0)
  horaFim       DateTime       @map("hora_fim") @db.Time(0)
  agendamentos  Agendamento[]

  @@map("profissional")
}

model Agendamento {
  id              Int                    @id @default(autoincrement())
  clienteId       Int                    @map("cliente_id")
  profissionalId  Int                    @map("profissional_id")
  tipoServico     String                 @map("tipo_servico") @db.VarChar(20)
  dataHora        DateTime               @map("data_hora")
  duracaoMinutos  Int                    @default(120) @map("duracao_minutos")
  endereco        String                 @db.VarChar(255)
  necessidades    String?
  status          String                 @default("PENDENTE") @db.VarChar(20)
  criadoEm        DateTime               @default(now()) @map("criado_em")
  cliente         Cliente                @relation(fields: [clienteId], references: [id])
  profissional    Profissional           @relation(fields: [profissionalId], references: [id])
  historicos      HistoricoAgendamento[]

  @@unique([profissionalId, dataHora])
  @@map("agendamento")
}

model HistoricoAgendamento {
  id              Int          @id @default(autoincrement())
  agendamentoId   Int          @map("agendamento_id")
  usuarioId       Int?         @map("usuario_id")
  acao            String       @db.VarChar(30)
  descricao       String
  dataOperacao    DateTime     @default(now()) @map("data_operacao")
  agendamento     Agendamento  @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  usuario         Usuario?     @relation(fields: [usuarioId], references: [id])

  @@map("historico_agendamento")
}
